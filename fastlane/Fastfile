# Store uploads and review automation for Enjoy Player.
#
# All lanes read credentials from the environment (same variables as the
# release scripts); `~/.config/enjoy-player/asc.env` +
# `AuthKey_<KEY_ID>.p8` are picked up automatically for local runs.
# Run via .github/scripts/fastlane.sh so the pinned Gemfile.lock is used.

require "time"

opt_out_usage

def load_asc_env_defaults
  env_file = File.expand_path("~/.config/enjoy-player/asc.env")
  return unless File.exist?(env_file)

  File.readlines(env_file).each do |line|
    key, value = line.strip.split("=", 2)
    next if key.nil? || value.nil? || ENV.key?(key)

    ENV[key] = value.gsub(/\A"(.*)"\z/m, '\1').gsub(/\A'(.*)'\z/m, '\1')
  end
end

def asc_key_path
  key_id = ENV.fetch("APP_STORE_CONNECT_API_KEY_ID")
  ENV["ASC_KEY_PATH"] ||
    File.expand_path("~/.config/enjoy-player/AuthKey_#{key_id}.p8")
end

def app_identifier
  ENV.fetch("APP_BUNDLE_IDENTIFIER", "ai.enjoy.player")
end

def version_created_at(version)
  Time.parse(version.created_date)
rescue ArgumentError, TypeError
  Time.at(0)
end

# AppStoreState values that mean App Review (or release gating) is still
# holding a version — mirrors spaceship's
# Spaceship::ConnectAPI::AppStoreVersion::AppStoreState enum. Everything
# else (ACCEPTED, READY_FOR_SALE, *_REMOVED_FROM_SALE, REPLACED_*) is
# historical/live and not what the review loop cares about.
IN_FLIGHT_REVIEW_STATES = [
  "PREPARE_FOR_SUBMISSION",
  "WAITING_FOR_EXPORT_COMPLIANCE",
  "WAITING_FOR_REVIEW",
  "READY_FOR_REVIEW",
  "IN_REVIEW",
  "PROCESSING_FOR_APP_STORE",
  "PENDING_CONTRACT",
  "PENDING_APPLE_RELEASE",
  "PENDING_DEVELOPER_RELEASE",
  "REJECTED",
  "METADATA_REJECTED",
  "DEVELOPER_REJECTED",
  "INVALID_BINARY"
].freeze

REJECTED_STATES = [
  "REJECTED",
  "METADATA_REJECTED",
  "DEVELOPER_REJECTED",
  "INVALID_BINARY"
].freeze

default_platform(:ios)

platform :android do
  desc "Upload the store AAB to Google Play (alpha draft by default)"
  lane :beta do
    sa_json = ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON"]
    if sa_json.nil? && ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH"]
      sa_json = File.read(ENV["GOOGLE_PLAY_SERVICE_ACCOUNT_JSON_PATH"])
    end
    UI.user_error!("GOOGLE_PLAY_SERVICE_ACCOUNT_JSON(_PATH) not set") if sa_json.nil?
    UI.user_error!("PLAY_AAB_PATH not set") if ENV["PLAY_AAB_PATH"].nil?

    upload_to_play_store(
      aab: ENV.fetch("PLAY_AAB_PATH"),
      package_name: ENV.fetch("GOOGLE_PLAY_PACKAGE_NAME", app_identifier),
      track: ENV.fetch("GOOGLE_PLAY_TRACK", "alpha"),
      release_status: ENV.fetch("GOOGLE_PLAY_RELEASE_STATUS", "draft"),
      json_key_data: sa_json,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end
end

platform :ios do
  desc "Upload the IPA to TestFlight"
  lane :beta do
    UI.user_error!("IPA_PATH not set") if ENV["IPA_PATH"].nil?

    pilot(
      ipa: ENV.fetch("IPA_PATH"),
      api_key: asc_api_key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Attach the latest processed build and submit the edited version for review"
  lane :submit_review do
    # run_precheck_before_submit stays off: precheck validates marketing
    # metadata (name, keywords, descriptions, screenshots) that this lane
    # never uploads (skip_metadata/skip_screenshots below) — a precheck
    # failure would block resubmission over content this pipeline doesn't
    # own. Warnings still surface; no force flag to silence them.
    deliver(
      api_key: asc_api_key,
      app_identifier: app_identifier,
      app_version: ENV.fetch("APP_VERSION"),
      submit_for_review: true,
      automatic_release: false,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      run_precheck_before_submit: false,
      # Load-bearing compliance claims: the app ships no proprietary crypto
      # (HTTPS via OS TLS only) and embeds third-party content — GPL FFmpeg /
      # eSpeak-NG (ADR-0094 Consequences, ADR-0072). Swap either dependency
      # or add crypto and re-answer here before the next submission.
      submission_information: {
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: true
      }
    )
  end

  desc "Print the review state of the in-flight (or latest) App Store version"
  lane :review_status do
    load_asc_env_defaults
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      filepath: asc_key_path
    )
    app = Spaceship::ConnectAPI::App.find(app_identifier)
    UI.user_error!("#{app_identifier} not found in App Store Connect") if app.nil?

    version = app.get_app_store_versions
                 .select { |v| IN_FLIGHT_REVIEW_STATES.include?(v.app_store_state) }
                 .max_by { |v| version_created_at(v) }
    version ||= app.get_latest_app_store_version
    UI.user_error!("No App Store version found") if version.nil?

    UI.message("version=#{version.version_string} state=#{version.app_store_state}")
    if REJECTED_STATES.include?(version.app_store_state)
      UI.message("Rejected — read the review notes in App Store Connect → Resolution Center.")
    end
  end

  private_lane :asc_api_key do
    load_asc_env_defaults
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: asc_key_path
    )
  end
end
