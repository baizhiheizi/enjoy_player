#!/usr/bin/env bash
# Pre-commit secret scanner.
#
# Blocks commits that ADD publish credentials: AWS / R2 access keys, secret
# assignments, R2 endpoint tokens, a bare 64-hex secret-shaped string outside
# known digest contexts, and the local credential / signing-key files.
#
# Only added lines are scanned. Deleted and context lines cannot leak a new
# secret; scanning them caused most historical false positives (a commit that
# merely removed a sha256 checksum was blocked). No dependencies beyond git +
# grep + sed, so this works in Git Bash, macOS bash 3.2, and Linux.
#
# See ADR-0104 for why this gate stays local and why CI needs its own scan.
#
# Install once per clone:
#   git config core.hooksPath .githooks
# Bypass for a known-good commit:
#   git commit --no-verify
# See docs/packaging.md -> "Publish credentials" for the secret-loading flow.
set -euo pipefail

forbidden_files=(
  ".github/scripts/publish_env.local.ps1"
  ".github/scripts/publish_env.local.sh"
  "dsa_priv.pem"
  "dsa_pub.pem"
)

quote='["'"'"']'

# High-confidence credential shapes. These block any file, including tests.
blocking_patterns=(
  'AKIA[0-9A-Z]{16}'
  "AWS_SECRET_ACCESS_KEY[[:space:]]*=[[:space:]]*${quote}?[0-9a-f]{40,}"
  "AWS_ACCESS_KEY_ID[[:space:]]*=[[:space:]]*${quote}?[0-9a-f]{32}"
  "(R2_SECRET_ACCESS_KEY|PUBLISH_[A-Z0-9_]*SECRET[A-Z0-9_]*)[[:space:]]*=[[:space:]]*${quote}?[0-9a-f]{40,}"
  "SPARKLE_DSA_PRIV_PEM_BASE64[[:space:]]*=[[:space:]]*${quote}?[A-Za-z0-9+/=]{80,}"
  'r2\.cloudflarestorage\.com/[0-9a-f]{20,}'
)

# A bare 64-hex value is indistinguishable from a public digest by shape, so
# it only blocks outside test fixtures and known digest contexts.
shape_patterns=(
  '[0-9a-f]{64}'
)

scan_staged() {
  local status=0 file added masked forbidden pat
  while IFS= read -r -d '' file; do
    for forbidden in "${forbidden_files[@]}"; do
      if [[ "$file" == "$forbidden" ]]; then
        echo "ERROR: refusing to commit tracked credential / key file: $file" >&2
        echo "       These files must stay local (see .gitignore)." >&2
        status=1
      fi
    done

    # Binaries, lockfiles and the example templates carry the literal patterns
    # as placeholders or content hashes, never live credentials.
    case "$file" in
      *.png|*.jpg|*.jpeg|*.gif|*.webp|*.icns|*.ico|*.zip|*.gz|*.lock) continue ;;
      ".github/scripts/publish_env.example.ps1") continue ;;
      ".github/scripts/publish_env.example.sh") continue ;;
      ".githooks/pre-commit") continue ;;
    esac

    added=$(git diff --cached --unified=0 -- "$file" 2>/dev/null \
      | grep -E '^[+][^+]' || true)
    if [[ -z "$added" ]]; then
      continue
    fi

    for pat in "${blocking_patterns[@]}"; do
      if printf '%s\n' "$added" | grep -Eq "$pat"; then
        echo "ERROR: possible leaked credential in $file matches /$pat/" >&2
        status=1
        break
      fi
    done

    # Fixture directories and tool-generated digest manifests contain nothing
    # but bare 64-hex values. The high-confidence rules above already ran.
    case "$file" in
      test/*|skills-lock.json|.specify/integrations/*.manifest.json) continue ;;
    esac

    # Mask only the hex a digest context actually describes — never drop the
    # whole line. A second, bare 64-hex secret on the same line must stay
    # visible to the shape rule. Order matters: sha256: is masked first.
    masked=$(printf '%s\n' "$added" \
      | sed -E 's/sha256:[0-9a-f]{64}/sha256:<digest>/g' \
      | sed -E 's/("[^"]*[Hh]ash"[[:space:]]*:[[:space:]]*")[0-9a-f]{64}(")/\1<digest>\2/g' \
      | sed -E 's/("[^"]*[/][^"]*"[[:space:]]*:[[:space:]]*")[0-9a-f]{64}(")/\1<digest>\2/g' \
      | sed -E "s/([Cc]hecksum|[Dd]igest|[Ss][Hh][Aa]-?256|[Hh]ash)[[:space:]]*[:=][[:space:]]*${quote}?[0-9a-f]{64}/\\1=<digest>/g")
    for pat in "${shape_patterns[@]}"; do
      if printf '%s\n' "$masked" | grep -Eq "$pat"; then
        echo "ERROR: bare 64-hex string added in $file (secret-shaped)." >&2
        echo "       Public digest? Use a sha256: prefix, a *hash JSON key, a" >&2
        echo "       checksum=/digest= assignment, or a tool-generated manifest." >&2
        status=1
        break
      fi
    done
  done

  if [[ "$status" -ne 0 ]]; then
    echo "" >&2
    echo "Commit blocked by secret scanner. Rotate any exposed keys and load" >&2
    echo "credentials from a secure store (see docs/packaging.md)." >&2
  fi
  return "$status"
}

git diff --cached --name-only -z --diff-filter=ACMR | scan_staged
