#!/usr/bin/env bash
# Pre-push gate: block pushes whose Dart sources are not formatted the way CI
# expects. Budget: ~3s.
#
# Codegen drift and flutter analyze are deliberately NOT run here. Both already
# run in CI on every PR (ci.yml "Analyze & test", codegen_drift.yml), and
# running build_runner on every push rewrites the working tree, can stall for
# up to 240s on a poisoned incremental cache, and in an agent worktree can
# delete checked-in generated files. See ADR-0104.
#
# Install once per clone:
#   git config core.hooksPath .githooks
# Full local mirror (format + codegen + analyze + tests):
#   bash .github/scripts/validate_ci_gates.sh --fix
# Bypass:
#   git push --no-verify

set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

# Skip the format check when no Dart / lib / package source is in the push
# range. Docs- and workflow-only pushes go straight through.
need_dart=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue
  fi
  if [[ "$remote_sha" =~ ^0+$ ]]; then
    # New branch: diff against where it forked from main. (A bare
    # `git diff <sha>` compares against the working tree, which is usually
    # clean right after committing.) No merge-base -> run the check.
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
    if [[ -z "$base" ]]; then
      need_dart=1
      break
    fi
    range="${base}..${local_sha}"
  else
    range="${remote_sha}..${local_sha}"
  fi
  if git diff --name-only "$range" 2>/dev/null | grep -Eq \
    '^(lib/|packages/|test/|pubspec\.(yaml|lock)|analysis_options\.yaml)|\.dart$'; then
    need_dart=1
    break
  fi
done

if [[ "$need_dart" -eq 0 ]]; then
  echo "pre-push: no Dart/lib/package changes in push range — skipping Dart format"
  exit 0
fi

echo "pre-push: checking Dart format..."
bash .github/scripts/check_dart_format.sh
