#!/usr/bin/env bash
# Pre-push gate: block pushes that would fail CI Dart format, Codegen drift,
# or flutter analyze. Budget: ~15s warm (format ~3s, codegen ~2s warm /
# ~40s cold, analyze ~7s). The full test suite runs in CI on every PR.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# Bypass (not recommended):
#   git push --no-verify

set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

# Codegen + analyze only when Dart/lib/package sources or lockfiles are among
# the commits being pushed. Docs/workflow-only pushes skip straight through.
need_dart=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue
  fi
  if [[ "$remote_sha" =~ ^0+$ ]]; then
    # New branch: diff against where it forked from main. (A bare
    # `git diff <sha>` compares against the working tree, which is usually
    # clean right after committing — that silently skipped codegen on the
    # first push of most PR branches.) No merge-base → run the gates.
    base="$(git merge-base "$local_sha" origin/main 2>/dev/null || true)"
    if [[ -z "$base" ]]; then
      need_dart=1
      break
    fi
    range="${base}..${local_sha}"
  else
    range="${remote_sha}..${local_sha}"
  fi
  if git diff --name-only "$range" 2>/dev/null | grep -Eq \
    '^(lib/|packages/|test/|pubspec\.(yaml|lock)|analysis_options\.yaml)|\.dart$'; then
    need_dart=1
    break
  fi
done

if [[ "$need_dart" -eq 0 ]]; then
  echo "pre-push: no Dart/lib/package changes in push range — skipping Dart gates"
  exit 0
fi

start=$SECONDS

echo "pre-push: checking Dart format..."
bash .github/scripts/check_dart_format.sh

echo "pre-push: checking codegen drift (build_runner)..."
bash .github/scripts/check_codegen_drift.sh

echo "pre-push: flutter analyze..."
flutter analyze </dev/null

echo "pre-push: ok ($((SECONDS - start))s)"
